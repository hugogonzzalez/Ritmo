# 1) Copia este archivo y llámalo .env
# 2) Pega tu clave de https://console.groq.com/keys (gratis, sin tarjeta)

GROQ_API_KEY=pega_aqui_tu_clave
GROQ_MODEL=llama-3.3-70b-versatile

PORT=3001

# Dirección de la API principal de Ritmo (para leer las valoraciones). Por defecto, localhost:3000
API_URL=http://localhost:3000/api
